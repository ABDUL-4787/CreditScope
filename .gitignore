# Root gitignore to coordinate frontend and backend exclusions

# python
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.pytest_cache/
backend/.venv/
backend/venv/
backend/creditscope.db
backend/scratch/

# next.js
frontend/.next/
frontend/out/
frontend/node_modules/

# environments and keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
backend/.env

# OS files
.DS_Store
Thumbs.db
